# HTTP server
PORT=4000

# SQLite file location (relative to apps/api or absolute)
DATABASE_PATH=data/database.db

# Required for signing access tokens. Generate e.g. with: openssl rand -base64 48
# for Powershell run: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})
JWT_SECRET=

# CORS origin for the web app
CLIENT_ORIGIN=http://localhost:3000

# Used by `bun run seed:admin`. No defaults ship in source.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
